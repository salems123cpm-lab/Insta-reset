local uiScale = Instance.new("UIScale")
uiScale.Name = "GuiScale"
uiScale.Scale = guiScaleValue
uiScale.Parent = frame

local function setGuiScale(scale)

	guiScaleValue = math.clamp(
		scale,
		MIN_SCALE,
		MAX_SCALE
	)

	TweenService:Create(
		uiScale,
		TweenInfo.new(
			0.12,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),
		{
			Scale = guiScaleValue
		}
	):Play()

	local percent =
		math.floor(guiScaleValue * 100 + 0.5)

	sizeLabel.Text =
		"GUI SIZE  " .. percent .. "%"

	local alpha =
		(guiScaleValue - MIN_SCALE)
		/ (MAX_SCALE - MIN_SCALE)

	sizeFill.Size =
		UDim2.new(alpha, 0, 1, 0)

	sizeKnob.Position =
		UDim2.new(alpha, -9, 0.5, -9)
end

local resizing = false

local function updateSizeFromX(x)

	local left =
		sizeBar.AbsolutePosition.X

	local width =
		sizeBar.AbsoluteSize.X

	if width <= 0 then
		return
	end

	local alpha =
		math.clamp(
			(x - left) / width,
			0,
			1
		)

	local scale =
		MIN_SCALE
		+ (MAX_SCALE - MIN_SCALE) * alpha

	setGuiScale(scale)
end

sizeKnob.InputBegan:Connect(function(input)

	if input.UserInputType ==
		Enum.UserInputType.MouseButton1
		or input.UserInputType ==
		Enum.UserInputType.Touch then

		resizing = true
	end
end)

sizeBar.InputBegan:Connect(function(input)

	if input.UserInputType ==
		Enum.UserInputType.MouseButton1
		or input.UserInputType ==
		Enum.UserInputType.Touch then

		resizing = true

		updateSizeFromX(
			input.Position.X
		)
	end
end)

UserInputService.InputChanged:Connect(function(input)

	if not resizing then
		return
	end

	if input.UserInputType ==
		Enum.UserInputType.MouseMovement
		or input.UserInputType ==
		Enum.UserInputType.Touch then

		updateSizeFromX(
			input.Position.X
		)
	end
end)

UserInputService.InputEnded:Connect(function(input)

	if input.UserInputType ==
		Enum.UserInputType.MouseButton1
		or input.UserInputType ==
		Enum.UserInputType.Touch then

		resizing = false
	end
end)

setGuiScale(1)

--==================================================
-- DRAG SYSTEM
--==================================================

local dragging = false
local dragStart
local startPosition

local function updateDrag(input)

	local delta =
		input.Position - dragStart

	frame.Position = UDim2.new(
		startPosition.X.Scale,
		startPosition.X.Offset + delta.X,
		startPosition.Y.Scale,
		startPosition.Y.Offset + delta.Y
	)
end

frame.InputBegan:Connect(function(input)

	if guiLocked then
		return
	end

	if input.UserInputType ==
		Enum.UserInputType.MouseButton1
		or input.UserInputType ==
		Enum.UserInputType.Touch then

		dragging = true
		dragStart = input.Position
		startPosition = frame.Position

		input.Changed:Connect(function()

			if input.UserInputState ==
				Enum.UserInputState.End then

				dragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)

	if guiLocked then
		return
	end

	if not dragging then
		return
	end

	if input.UserInputType ==
		Enum.UserInputType.MouseMovement
		or input.UserInputType ==
		Enum.UserInputType.Touch then

		updateDrag(input)
	end
end)


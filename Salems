-- RESET LOGIC
--==================================================

button.MouseButton1Click:Connect(function()

	local character =
		player.Character

	if not character then

		status.Text =
			"● NO CHARACTER"

		status.TextColor3 =
			Color3.fromRGB(225, 95, 95)

		return
	end

	local hrp =
		character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not hrp then

		status.Text =
			"● NO ROOT PART"

		status.TextColor3 =
			Color3.fromRGB(225, 95, 95)

		return
	end

	status.Text =
		"● RESETTING..."

	status.TextColor3 =
		Color3.fromRGB(210, 210, 220)

	local originalCFrame =
		hrp.CFrame

	hrp.CFrame =
		originalCFrame
		+ Vector3.new(0, 1000000, 0)

	task.wait(0.1)

	if hrp and hrp.Parent then
		hrp.CFrame =
			originalCFrame
	end

	status.Text =
		"● RESET COMPLETE"

	status.TextColor3 =
		Color3.fromRGB(200, 200, 210)

	task.wait(1)

	status.Text =
		"● READY"

	status.TextColor3 =
		Color3.fromRGB(155, 155, 165)
end)
